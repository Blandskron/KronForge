{
  "name": "kronforge",
  "version": "3.4.3",
  "type": "module",
  "description": "KronForge: plataforma documental abierta de AI Engineering con catálogo v3, prompts, skills y protocolos reutilizables sin dependencias.",
  "license": "MIT",
  "author": {
    "name": "Blandskron",
    "url": "https://github.com/Blandskron"
  },
  "homepage": "https://blandskron.github.io/KronForge/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blandskron/KronForge.git"
  },
  "bugs": {
    "url": "https://github.com/Blandskron/KronForge/issues"
  },
  "keywords": [
    "kronforge",
    "ai-engineering",
    "agents-first",
    "agents",
    "prompts",
    "skills",
    "mcp",
    "protocols",
    "documentation"
  ],
  "types": "./scripts/api.d.ts",
  "exports": {
    ".": {
      "types": "./scripts/api.d.ts",
      "import": "./scripts/api.mjs"
    },
    "./catalog": "./library/catalog.json",
    "./schema": "./library/schema/catalog-v3.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "kronforge": "./scripts/cli.mjs"
  },
  "files": [
    "library/",
    "prompts/",
    "skills/",
    "llms.txt",
    "scripts/api.mjs",
    "scripts/api.d.ts",
    "scripts/cli.mjs",
    "scripts/lib/detector.mjs",
    "scripts/lib/context-discovery.mjs",
    "scripts/lib/packs.mjs",
    "scripts/lib/context-generator.mjs",
    "scripts/lib/installer.mjs",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "build:llms": "node scripts/build-llms.mjs",
    "build": "npm run build:skills && npm run build:llms && node scripts/build-learning.mjs",
    "test": "node --test",
    "smoke": "node scripts/smoke-site.mjs",
    "score": "node scripts/score.mjs",
    "quality": "npm run validate && npm test && npm run smoke && npm run score",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run quality"
  },
  "engines": {
    "node": ">=24"
  }
}
